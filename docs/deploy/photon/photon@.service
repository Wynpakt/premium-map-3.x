[Unit]
Description=Photon 0.5 geocoder (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=photon
Group=photon
EnvironmentFile=/etc/photon/%i.env
ExecStart=/opt/photon/run.sh
Restart=on-failure
RestartSec=15
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
