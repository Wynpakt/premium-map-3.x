# Collmex sync, then Photon geocoding.
# Install on the API host, for example:
#   sudo cp docs/cron/landkarte.cron /etc/cron.d/landkarte
#   sudo chmod 644 /etc/cron.d/landkarte
#
# The repository did not previously ship a cron unit. Without this, changes
# in Collmex stay off the map until someone runs the two commands by hand.
# www-data must be able to create the log files:
#   sudo install -d -o www-data -g www-data /var/log/landkarte
#   sudo cp docs/deploy/logrotate-landkarte /etc/logrotate.d/landkarte
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

15 * * * * www-data cd /var/www/api.landkarte.premium-cola.de && php app/cli.php update >> /var/log/landkarte/sync.log 2>&1
25 * * * * www-data test ! -f /var/lib/photon/refresh.lock && cd /var/www/api.landkarte.premium-cola.de && flock -n /var/lock/landkarte-geo.lock php app/cli.php update geo >> /var/log/landkarte/geo.log 2>&1

# Photon OSM dumps, 04:10 on the 1st. No-ops when the dated archive has not changed.
# update geo skips while /var/lib/photon/refresh.lock exists.
10 4 1 * * root /opt/photon/refresh-indexes.sh >> /var/log/landkarte/photon-refresh.log 2>&1
